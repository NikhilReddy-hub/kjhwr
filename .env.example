# WindScope — Environment Variables
# Copy this file to .env and fill in the values

# Application
DEBUG=false
APP_NAME="Wind Procurement Portal"
APP_VERSION=1.0.0

# Default decision cutoff (UK local time, 24h)
DEFAULT_CUTOFF_HOUR_LOCAL=9
DEFAULT_CUTOFF_MINUTE_LOCAL=0

# Data scope
DATA_START_DATE=2025-12-30
DATA_END_DATE=2026-01-31

# Database path (relative to backend/)
DB_PATH=data/wind_data.db

# Elexon API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT=30.0
ELEXON_RETRIES=3

# CORS (use specific origins in production, e.g. https://your-frontend.com)
CORS_ORIGINS=["*"]
